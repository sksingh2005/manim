# Copy to backend/.env (never commit real keys)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional gate: if set, clients must send x-api-key header
API_KEY=
JOBS_DIR=/tmp/manim-jobs
DATABASE_PATH=/tmp/manim-state/jobs.sqlite3
RENDER_TIMEOUT_SEC=300
ALLOW_HIGH_QUALITY=false

# Optional Cloudflare R2. Set all four values to enable uploads.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional semantic reuse. Run: docker compose --profile reuse up --build
# Requires OPENAI_API_KEY for embeddings even if a different code model is used.
QDRANT_URL=
QDRANT_COLLECTION=manim_videos
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.93
