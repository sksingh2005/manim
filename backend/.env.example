# Copy to backend/.env (never commit real keys)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_RATE_LIMIT_RETRIES=2
LLM_RATE_LIMIT_WAIT_SEC=65
# Repairs per invalid lesson-plan/storyboard stage, from 0 to 2.
PLANNING_REPAIR_ATTEMPTS=1
# Optional gate: if set, clients must send x-api-key header
API_KEY=
JOBS_DIR=/tmp/manim-jobs
DATABASE_PATH=/tmp/manim-state/jobs.sqlite3
RENDER_TIMEOUT_SEC=300
ALLOW_HIGH_QUALITY=false

# Optional Cloudflare R2. Set all four values to enable uploads.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional semantic reuse. Run: docker compose --profile reuse up --build
# Requires GOOGLE_API_KEY (or GEMINI_API_KEY) for Gemini prompt embeddings.
QDRANT_URL=
QDRANT_COLLECTION=manim_videos
EMBEDDING_MODEL=models/gemini-embedding-001
SIMILARITY_THRESHOLD=0.93
